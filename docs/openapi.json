                },
                "example": {
                  "error": {
                    "code": "method_not_allowed",
                    "message": "Metodo HTTP nao permitido nesta rota"
                  }
                }
              }
            },
            "headers": {
              "Allow": {
                "description": "Métodos permitidos para o recurso.",
                "schema": {
                  "type": "string",
                  "const": "GET, PUT, PATCH, DELETE"
                },
                "example": "GET, PUT, PATCH, DELETE"
              }
            }
          },
          "500": {
            "description": "Erro ao acessar dados",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "database_error",
                    "message": "Erro ao acessar dados"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, malformado, expirado, revogado ou conta inativa.",
            "headers": {
              "WWW-Authenticate": {
                "description": "Desafio Bearer.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
