                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Autenticar usuario",
        "operationId": "login",
        "description": "Retorna token opaco com TTL de uma hora; envio somente por HTTPS ou loopback.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthLoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token de sessao criado; Cache-Control: no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthLoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "JSON invalido ou incompleto."
          },
          "401": {
            "description": "Token ausente, malformado, expirado, revogado ou conta inativa.",
            "headers": {
              "WWW-Authenticate": {
                "description": "Desafio Bearer.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "411": {
            "description": "Content-Length obrigatorio."
          },
          "415": {
            "description": "Content-Type application/json obrigatorio."
          },
          "429": {
            "description": "Limite temporario de login por conta/origem ou sobrecarga Argon2id.",
            "headers": {
              "Retry-After": {
                "description": "Tempo sugerido para nova tentativa, em segundos (1 ou 60).",
                "schema": {
                  "type": "integer",
                  "enum": [
                    1,
                    60
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Consultar identidade",
        "operationId": "getAuthenticatedPrincipal",
        "description": "Valida a sessao, a expiracao e o estado da conta no momento da consulta.",
        "responses": {
          "200": {
            "description": "Conta autenticada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthPrincipal"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, malformado, expirado, revogado ou conta inativa.",
            "headers": {
              "WWW-Authenticate": {
                "description": "Desafio Bearer.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Revogar token",
        "operationId": "logout",
        "description": "Revoga o token enviado no cabecalho Authorization. Nao aceita body.",
        "responses": {
          "204": {
            "description": "Sessao revogada; sem corpo."
          },
          "401": {
            "description": "Token ausente, malformado, expirado, revogado ou conta inativa.",
            "headers": {
              "WWW-Authenticate": {
                "description": "Desafio Bearer.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Limit": {
        "name": "limit",
        "in": "query",
        "description": "Quantidade de usuários por página (padrão 20).",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "example": 20
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "description": "Índice inicial (padrão 0).",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "example": 0
      },
      "UserId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Identificador positivo em decimal.",
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        },
        "example": 1
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "email"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "readOnly": true,
            "description": "ID gerado pelo SQLite; não é reutilizado após exclusão."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Nome após trim; caracteres de controle não são aceitos."
          },
          "email": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254,
            "description": "E-mail ASCII válido, convertido para minúsculas; comparação de unicidade sem diferenciar maiúsculas/minúsculas."
          }
        },
        "example": {
          "id": 1,
          "name": "Ana Silva",
          "email": "ana@example.com"
        }
      },
      "UserCreate": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 2,
        "required": [
          "name",
          "email"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Nome sem caracteres de controle (trim aplicado)."
          },
          "email": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254,
            "description": "E-mail ASCII; normalizado para minúsculas."
          }
        },
        "example": {
          "name": "Ana Silva",
          "email": "ana@example.com"
        }
      },
      "UserPatch": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "email": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254
          }
        },
        "example": {
          "name": "Ana Atualizada"
        }
      },
      "UserEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "total",
          "limit",
          "offset"
        ],
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "UserListEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "pagination"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Identificador estável do erro (por exemplo, validation_error)."
          },
          "message": {
            "type": "string",
            "description": "Mensagem explicativa em português."
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiError"
          }
        }
      },
      "AuthLoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "description": "Login ASCII."
          },
          "password": {
            "type": "string",
            "description": "Senha. Nunca armazene em logs."
          }
        }
      },
      "AuthLoginResponse": {
        "type": "object",
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "expires_at"
        ],
        "properties": {
          "access_token": {
            "type": "string",
            "description": "Segredo Bearer opaco (64 caracteres hexadecimais)."
          },
          "token_type": {
            "type": "string",
            "const": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "const": 3600
          },
          "expires_at": {
            "type": "integer"
          }
        }
      },
      "AuthPrincipal": {
        "type": "object",
        "required": [
          "id",
          "username",
          "role",
          "expires_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "username": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "viewer",
              "editor",
              "admin"
            ]
          },
          "expires_at": {
            "type": "integer"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token opaco hexadecimal de 256 bits obtido em POST /api/v1/auth/login; valido por 1h."
      }
    }
  }
}
