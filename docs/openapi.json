        "summary": "Listar usuários",
        "operationId": "listUsers",
        "description": "Ordenados por ID crescente. Padrão: limit=20 e offset=0. Parâmetros repetidos, desconhecidos ou não numéricos são rejeitados. GET não aceita corpo. Requer Bearer com papel viewer/editor/admin.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Offset"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista paginada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserListEnvelope"
                },
                "example": {
                  "data": [
                    {
                      "id": 1,
                      "name": "Ana Silva",
                      "email": "ana@example.com"
                    }
                  ],
                  "pagination": {
                    "total": 1,
                    "limit": 20,
                    "offset": 0
                  }
                }
              }
            }
          },
          "400": {
            "description": "Parâmetros de paginação inválidos, duplicados ou não reconhecidos; também pode ocorrer com corpo em GET.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "bad_request",
                    "message": "Requisicao invalida"
                  }
                }
              }
            }
          },
          "405": {
            "description": "Metodo HTTP nao permitido nesta rota",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "method_not_allowed",
                    "message": "Metodo HTTP nao permitido nesta rota"
                  }
                }
              }
            },
            "headers": {
              "Allow": {
                "description": "Métodos permitidos para a coleção.",
                "schema": {
                  "type": "string",
                  "const": "GET, POST"
                },
                "example": "GET, POST"
              }
            }
          },
          "500": {
            "description": "Erro ao acessar dados",
