        ],
        "summary": "Excluir usuário",
        "operationId": "deleteUser",
        "description": "Remove o registro, sem reutilização posterior do ID. DELETE não aceita corpo ou query string. Requer Bearer admin.",
        "responses": {
          "204": {
            "description": "Excluído com sucesso. Resposta sem corpo e sem Content-Length."
          },
          "400": {
            "description": "Requisicao invalida",
