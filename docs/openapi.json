                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "not_found",
                    "message": "Recurso nao encontrado"
                  }
                }
              }
            }
          },
          "405": {
            "description": "Metodo HTTP nao permitido nesta rota",
            "content": {
              "application/json": {
                "schema": {
